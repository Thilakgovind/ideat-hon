# SafePath V1 — copy to .env and fill in. Every key is optional:
# a missing key switches that service to a mock (demo mode).
# Format: NAME=value  (no spaces around =, no labels, one name per line)
# Check with:  python -m backend.check_keys

# --- AI (backend only) ---
GEMINI_API_KEY=
# optional, default gemini-3.1-flash-lite
GEMINI_MODEL=
SARVAM_API_KEY=

# --- SMS / voice call-back (backend only) ---
# SMS_PROVIDER: mock | twilio | fast2sms | textbee
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Optional: signing secret of the textbee webhook (inbound SMS signature check)
TEXTBEE_WEBHOOK_SECRET=

# --- Payments: TEST mode only (rzp_test_...). Live keys are refused. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Map (public, used by the frontend) ---
MAPTILER_KEY=

# --- Database ---
SUPABASE_URL=
# Anon / publishable key: public, read-only on places + reviews
SUPABASE_ANON_KEY=
# Service key: backend only, never in frontend or VITE_ variables
SUPABASE_SERVICE_KEY=
# Optional, your machine only: session pooler URI, used by `python -m backend.db_migrate`
SUPABASE_DB_URL=

# --- n8n + public URL ---
N8N_WEBHOOK_URL=
N8N_ORCHESTRATOR_URL=
# ngrok https URL for this backend (Twilio call-back needs it)
PUBLIC_BACKEND_URL=

DEMO_MODE=true

# Optional: 1-2 of YOUR verified test numbers for demo circle contacts (never commit real numbers)
DEMO_CONTACT_PHONE_1=
DEMO_CONTACT_PHONE_2=
